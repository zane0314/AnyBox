#!/bin/sh
set -eu
real="/opt/homebrew/share/android-commandlinetools/build-tools/37.0.0/aapt2"
if [ "${1:-}" = compile ] && [ "${2:-}" = --dir ]; then
  root=$3
  out=""
  prev=""
  for arg in "$@"; do
    if [ "$prev" = -o ]; then out=$arg; fi
    prev=$arg
  done
  stage=$(mktemp -d /tmp/aapt2-flat.XXXXXX)
  trap 'rm -rf "$stage"' EXIT
  mkdir -p "$stage/merged"
  find "$root" -type f -print0 | while IFS= read -r -d '' file; do
    base=$(basename "$file")
    part="$stage/${base}.zip"
    "$real" compile --legacy "$file" -o "$part"
    unzip -q -o "$part" -d "$stage/merged"
  done
  (cd "$stage/merged" && zip -q -X -r "$out" .)
  exit 0
fi
exec "$real" "$@"
