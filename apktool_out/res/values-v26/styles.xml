<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.AppCompat" parent="@style/Base.V26.Theme.AppCompat" />
    <style name="Base.Theme.AppCompat.Light" parent="@style/Base.V26.Theme.AppCompat.Light" />
    <style name="Base.V26.Theme.AppCompat" parent="@style/Base.V23.Theme.AppCompat">
        <item name="colorError">?android:colorError</item>
    </style>
    <style name="Base.V26.Theme.AppCompat.Light" parent="@style/Base.V23.Theme.AppCompat.Light">
        <item name="colorError">?android:colorError</item>
    </style>
    <style name="Base.V26.Widget.AppCompat.Toolbar" parent="@style/Base.V7.Widget.AppCompat.Toolbar">
        <item name="android:touchscreenBlocksFocus">true</item>
        <item name="android:keyboardNavigationCluster">true</item>
    </style>
    <style name="Base.Widget.AppCompat.Toolbar" parent="@style/Base.V26.Widget.AppCompat.Toolbar" />
    <style name="Theme.SagerNet" parent="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionBarTheme">@style/ThemeOverlay.SagerNet.Toolbar</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="actionOverflowMenuStyle">@style/Widget.SagerNet.PopupMenu.Overflow</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.SagerNet.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SagerNet.BottomSheetDialog</item>
        <item name="cardElevatedSurfaceColor">@color/card_elevated_pink</item>
        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="colorAccent">@color/material_pink_accent_200</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="colorMaterial100">@color/material_pink_100</item>
        <item name="colorMaterial300">@color/material_pink_300</item>
        <item name="colorPrimary">@color/material_pink_500</item>
        <item name="colorPrimaryDark">@color/material_pink_700</item>
        <item name="fabColorBackground">?colorPrimary</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialButtonStyle">@style/Widget.SagerNet.Button</item>
        <item name="materialCardViewStyle">@style/Widget.SagerNet.CardView</item>
        <item name="popupMenuStyle">@style/Widget.SagerNet.PopupMenu</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="skinOverlaySurfaceColor">@color/personal_surface</item>
        <item name="tabIndicatorColor">?colorPrimary</item>
        <item name="tabRippleColor">?colorPrimary</item>
        <item name="tabSelectedTextColor">?colorPrimary</item>
        <item name="tabTextColor">?android:textColorSecondary</item>
        <item name="textInputStyle">@style/Widget.SagerNet.TextInputLayout</item>
        <item name="whiteOrTextPrimary">@color/white</item>
        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Widget.Design.AppBarLayout" parent="@android:style/Widget">
        <item name="android:background">?colorPrimary</item>
        <item name="android:stateListAnimator">@animator/design_appbar_state_list_animator</item>
        <item name="android:touchscreenBlocksFocus">true</item>
        <item name="android:keyboardNavigationCluster">true</item>
    </style>
</resources>
