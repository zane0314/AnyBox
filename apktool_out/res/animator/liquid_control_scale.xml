<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:duration="90" android:valueTo="0.98" android:valueType="floatType" android:propertyName="scaleX" />
            <objectAnimator android:duration="90" android:valueTo="0.98" android:valueType="floatType" android:propertyName="scaleY" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:duration="140" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleX" />
            <objectAnimator android:duration="140" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleY" />
        </set>
    </item>
</selector>
