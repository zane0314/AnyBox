<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/liquid_control_ripple"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1fffffff" android:endColor="#0d8db8e6" android:angle="315.0" android:centerColor="#14ffffff" />
            <corners android:radius="@dimen/liquid_icon_corner_radius" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/liquid_icon_corner_radius" />
        </shape>
    </item>
</ripple>
